{
  "name": "Everforest - Light",
  "style": "Light",
  "author": {
    "name": "Aric Crosson Bouwers",
    "email": "0many-treaty@icloud.com"
  },
  "editor": {
    "backgroundColor": "#F7F3E8",
    "altBackground": "#E6E6E6",
    "altBackgroundColor": "#E6E6E6",
    "tintColor": "#AB7693",
    "tintColor2": "#6BA3B0",
    "textColor": "#5C5A4A",
    "toolbarBackgroundColor": "#E6E6E6",
    "toolbarIconColor": "#6B7A6E",
    "menuItemColor": "#6BA3B0",
    "timeBlockColor": "#5B7B55",
    "shouldOverwriteFont": false,
    "sidebarIconColorOverride": "#5C5A4A",
    "lineSpacing": 1
  },
  "orderedStyles": [
    "title-mark1",
    "title-mark2",
    "title-mark3",
    "title-mark4",
    "title-mark5",
    "title-mark6",
    "code",
    "code-fence",
    "body",
    "quote-content",
    "bold",
    "bold-left-mark",
    "bold-right-mark",
    "italic",
    "italic-left-mark",
    "italic-right-mark",
    "boldItalic",
    "boldItalic-left-mark",
    "boldItalic-right-mark",
    "code-left-backtick",
    "code-right-backtick",
    "special-char",
    "checked-todo-characters",
    "todo",
    "checked",
    "quote-mark",
    "tabbed",
    "link",
    "hashtag",
    "attag",
    "schedule-to-date-link",
    "done-date",
    "schedule-from-date-link",
    "note-title-link",
    "title1",
    "title2",
    "title3",
    "title4",
    "title5",
    "title6",
    "note-title-link",
    "NoteLinks-normal-left-brackets",
    "NoteLinks-normal-right-brackets",
    "NoteLinks-folgzettel-left-brackets",
    "NoteLinks-folgzettel-right-brackets",
    "NoteLinks-project-left-brackets",
    "NoteLinks-project-right-brackets"
  ],
  "styles": {
    "body": {
      "font": "AvenirNext-Regular",
      "size": 16,
      "color": "#5C5A4A"
    },
    "hidden-title:-in-frontmatter": {
      "regex": "(^[tT]itle:\\s+)((.*\n))",
      "matchPosition": 1,
      "color": "#5C5A4A",
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true,
      "lineSpacing": 2,
      "paragraphSpacingBefore": 2
    },
    "formatted-title-in-frontmatter": {
      "regex": "(^[tT]itle:\\s+)((.*\n))",
      "matchPosition": 2,
      "color": "#5C5A4A",
      "size": 28,
      "font": "PPNeueMontreal-Bold",
      "lineSpacing": 2,
      "paragraphSpacingBefore": 2
    },
    "hidden-obsidian-frontmatter": {
      "regex": "((?<!.)^\\s*---\\n)([\\s\\S]*?)(\\n---)",
      "matchPosition": 1,
      "isMarkdownCharacter": true,
      "isRevealOnCursorRange": true,
      "isHiddenWithoutCursor": true,
      "color": "#AA888888"
    },
    "checked": {
      "color": "#A39599",
      "headIndent": 33
    },
    "checked-canceled": {
      "strikethroughStyle": 1,
      "matchPosition": 3,
      "regex": "(^\\h*[\\+|\\*\\-]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\-\\] )(.*)",
      "color": "#D5E2D7"
    },
    "checked-canceled-marker": {
      "matchPosition": 1,
      "regex": "(^\\h*[\\+|\\*\\-]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\-\\] )(.*)",
      "color": "#D5E2D7"
    },
    "checked-scheduled": {
      "regex": "(^\\h*[\\+|\\*\\-]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\>\\] )(.*)",
      "matchPosition": 0,
      "color": "#7FBBB3"
    },
    "todo": {
      "font": "noteplanstate",
      "color": "#BF8154",
      "headIndent": 33,
      "size": 16
    },
    "checked-todo-characters": {
      "font": "noteplanstate",
      "headIndent": 33,
      "size": 16
    },
    "flagged-1": {
      "regex": "(^[\\h\\v]*[\\*\\-\\+] (\\[(?!X\\])\\] )?)(.*!{1}.*[\\h\\v])",
      "matchPosition": 3,
      "backgroundColor": "#E9D6DA",
      "color": "#5C5A4A",
      "font": "Montserrat-Regular"
    },
    "flagged-2": {
      "regex": "(^[\\h\\v]*[\\*\\-\\+] (\\[(?!X\\])\\] )?)(.*!{2}.*[\\h\\v])",
      "matchPosition": 3,
      "backgroundColor": "#DBBAC1",
      "color": "#5C5A4A",
      "font": "Montserrat-Regular"
    },
    "flagged-3": {
      "regex": "(^[\\h\\v]*[\\*\\-\\+] (\\[(?!X\\])\\] )?)(.*!{3,}.*[\\h\\v])",
      "matchPosition": 3,
      "backgroundColor": "#C38C97",
      "color": "#F7F3E8",
      "font": "Montserrat-Regular"
    },
    "working-on": {
      "regex": ".*>>.*",
      "matchPosition": 0,
      "backgroundColor": "#5B7B55",
      "color": "#F7F3E8"
    },
    "waiting-on": {
      "regex": ".*<<.*",
      "matchPosition": 0,
      "color": "#F7F3E8",
      "backgroundColor": "#A39599",
      "borderRadius": 6,
      "leftBorderPadding": 6,
      "rightBorderPadding": 6
    },
    "hashtag": {
      "backgroundColor": "#F1EADA"
    },
    "attag": {
      "backgroundColor": "#F1EADA"
    },
    "bold": {
      "color": "#7FBBB3",
      "font": "Montserrat-SemiBold",
      "size": 16
    },
    "bold-left-mark": {
      "color": "#BF8154"
    },
    "bold-right-mark": {
      "color": "#BF8154"
    },
    "italic": {
      "color": "#63906A",
      "font": "Restora",
      "size": 17
    },
    "italic-left-mark": {
      "color": "#779E80"
    },
    "italic-right-mark": {
      "color": "#779E80"
    },
    "boldItalic": {
      "font": "RestoraBoldItalic",
      "size": 17
    },
    "boldItalic-left-mark": {
      "color": "#BF8154"
    },
    "boldItalic-right-mark": {
      "color": "#BF8154"
    },
    "code": {
      "font": "JetBrainsMono-Regular",
      "backgroundColor": "#EEEAE0",
      "size": 15
    },
    "code-fence": {
      "theme": "gruvbox-light",
      "body": {
        "font": "JetBrainsMono-Regular",
        "paragraphSpacingAfter": 2,
        "paragraphSpacing": 0,
        "size": 14
      },
      "corner-radius": 8,
      "fence-open": {
        "color": "#6584A2"
      },
      "fence-close": {
        "color": "#6584A2"
      },
      "language-specifier": {
        "font": "JetBrainsMono-Italic",
        "color": "#E69875",
        "size": 14,
        "paragraphSpacing": 0
      }
    },
    "code-left-backtick": {
      "color": "#6BA3B0"
    },
    "code-right-backtick": {
      "color": "#6BA3B0"
    },
    "tabbed": {
      "headIndent": 43
    },
    "quote-mark": {
      "color": "#5B7B55",
      "font": "noteplanstate",
      "headIndent": 33,
      "size": 16
    },
    "quote-content": {
      "color": "#7C9381",
      "type": "italic",
      "headIndent": 33
    },
    "link": {},
    "schedule-to-date-link": {},
    "done-date": {},
    "schedule-from-date-link": {},
    "note-title-link": {},
    "phonenumber": {
      "backgroundColor": "#7745A2E5"
    },
    "highlighted": {
      "leftBorderPadding": 4,
      "backgroundColor": "#D4CED0B7",
      "rightBorderPadding": 4,
      "color": "#5C5A4A"
    },
    "highlighted-left-marker": {
      "color": "#AACBCCC6"
    },
    "highlighted-right-marker": {
      "color": "#AACBCCC6"
    },
    "strikethrough": {
      "color": "#AACBCCC6",
      "strikethroughColor": "#CBCCC6"
    },
    "strikethrough-left-tilde": {
      "color": "#66CBCCC6"
    },
    "strikethrough-right-tilde": {
      "color": "#66CBCCC6"
    },
    "underline": {
      "isRevealOnCursorRange": true,
      "underlineStyle": 2,
      "matchPosition": 3,
      "regex": "(^|[\\W_])(?:(?!\\1)|(?=^))(\\~|_)(?=\\S)((?:(?!\\2).)*?\\S)(\\2)(?!\\2)(?=[\\W_]|$)",
      "underlineColor": "#5B7B55"
    },
    "underline-left-tilde": {
      "isRevealOnCursorRange": true,
      "isHiddenWithoutCursor": true,
      "isMarkdownCharacter": false,
      "matchPosition": 2,
      "regex": "(^|[\\W_])(?:(?!\\1)|(?=^))(\\~|_)(?=\\S)((?:(?!\\2).)*?\\S)(\\2)(?!\\2)(?=[\\W_]|$)",
      "color": "#66CBCCC6"
    },
    "underline-right-tilde": {
      "isRevealOnCursorRange": true,
      "isHiddenWithoutCursor": true,
      "isMarkdownCharacter": false,
      "matchPosition": 4,
      "regex": "(^|[\\W_])(?:(?!\\1)|(?=^))(\\~|_)(?=\\S)((?:(?!\\2).)*?\\S)(\\2)(?!\\2)(?=[\\W_]|$)",
      "color": "#66CBCCC6"
    },
