    },
    "code-right-backtick": {
      "color": "#73B3C0"
    },
    "checked": {
      "color": "#a7c080",
      "headIndent": 33
    },
    "checked-canceled": {
      "strikethroughStyle": 1,
      "matchPosition": 3,
      "regex": "(^\\h*[\\+|\\*\\-]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\-\\] )(.*)",
      "color": "#928383"
    },
    "checked-canceled-marker": {
      "matchPosition": 1,
      "regex": "(^\\h*[\\+|\\*\\-]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\-\\] )(.*)",
      "color": "#928383"
    },
    "checked-scheduled": {
      "regex": "(^\\h*[\\*\\-]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\>\\] )(.*)",
      "matchPosition": 0,
      "color": "#7FBBB3"
    },
