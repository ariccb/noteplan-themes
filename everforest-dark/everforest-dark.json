    "body": {
      "font": "SNPro-Regular",
      "size": 16,
      "color": "#C7C0AE",
      "paragraphSpacing": 20
    },
    "hidden-title:-in-frontmatter": {
      "regex": "(^[tT]itle:\\s+)((.*\n))",
      "matchPosition": 1,
      "color": "#C7C0AE",
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true,
      "lineSpacing": 2,
      "paragraphSpacingBefore": 2
    },
    "formatted-title-in-frontmatter": {
      "regex": "(^[tT]itle:\\s+)((.*\n))",
      "matchPosition": 2,
      "color": "#C7C0AE",
      "size": 28,
      "font": "SNPro-Bold",
      "lineSpacing": 2,
      "paragraphSpacingBefore": 2
    },
    "hidden-obsidian-frontmatter": {
      "regex": "((?<!.)^\\s*---\\n)([\\s\\S]*?)(\\n---)",
      "matchPosition": 1,
      "isMarkdownCharacter": true,
      "isRevealOnCursorRange": true,
      "isHiddenWithoutCursor": true,
      "color": "#AA888888"
    },
    "title1": {
      "color": "#C7C0AE",
      "size": 28,
