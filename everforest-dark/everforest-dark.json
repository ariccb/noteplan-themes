    "working-on": {
      "regex": ".*>>.*",
      "matchPosition": 0,
      "backgroundColor": "#a7c080",
      "color": "#232a2e"
    },
    "waiting-on": {
      "regex": ".*<<.*",
      "matchPosition": 0,
      "color": "#C7C0AE",
      "backgroundColor": "#4d4c43",
      "borderRadius": 6,
      "leftBorderPadding": 6,
      "rightBorderPadding": 6
    },
    "flagged-1": {
      "regex": "(^[\\h\\v]*[\\*|-|+] (\\[ \\] )?)(.*!{1}.*[\\h\\v])",
      "matchPosition": 3,
      "backgroundColor": "#2e2e33",
      "color": "#C7C0AE",
      "size": 15,
      "font": "Montserrat-Regular"
    },
    "flagged-2": {
      "regex": "(^[\\h\\v]*[\\*|-|+] (\\[ \\] )?)(.*!{2}.*[\\h\\v])",
      "matchPosition": 3,
      "backgroundColor": "#4B3A41",
      "color": "#C7C0AE",
      "size": 15,
      "font": "Montserrat-Regular"
    },
    "flagged-3": {
      "regex": "(^[\\h\\v]*[\\*|-|+] (\\[ \\] )?)(.*!{3,}.*[\\h\\v])",
      "matchPosition": 3,
      "backgroundColor": "#68454F",
      "color": "#F4EDDB",
      "size": 15,
      "font": "Montserrat-Regular"
    },
