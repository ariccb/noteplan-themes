{
  "name": "Supernotes - Deuterium",
  "style": "Light",
  "author": {
    "name": "Aric Crosson Bouwers",
    "email": "0many-treaty@icloud.com"
  },
  "editor": {
    "backgroundColor": "#F4EEEB",
    "altBackgroundColor": "#E9E0DB",
    "tintColor": "#F55774",
    "tintColor2": "#A8C4A9",
    "textColor": "#4B474A",
    "toolbarBackgroundColor": "#F4F0EE",
    "toolbarIconColor": "#534E4C",
    "menuItemColor": "#E9E0DB",
    "timeBlockColor": "#65A083",
    "shouldOverwriteFont": false,
    "sidebarIconColorOverride": "#6A686F",
    "lineSpacing": 1
  },
  "orderedStyles": [
    "title-mark1",
    "title-mark2",
    "title-mark3",
    "title-mark4",
    "title-mark5",
    "title-mark6",
    "code",
    "code-fence",
    "body",
    "quote-content",
    "bold",
    "bold-left-mark",
    "bold-right-mark",
    "italic",
    "italic-left-mark",
    "italic-right-mark",
    "boldItalic",
    "boldItalic-left-mark",
    "boldItalic-right-mark",
    "code-left-backtick",
    "code-right-backtick",
    "special-char",
    "checked-todo-characters",
    "todo",
    "checked",
    "quote-mark",
    "tabbed",
    "link",
    "hashtag",
    "attag",
    "schedule-to-date-link",
    "done-date",
    "schedule-from-date-link",
    "note-title-link",
    "title1",
    "title2",
    "title3",
    "title4",
    "title5",
    "title6",
    "note-title-link"
  ],
  "styles": {
    "body": {
      "font": "SNPro-Regular",
      "size": 16,
      "color": "#323135",
      "paragraphSpacing": 1
    },
    "hidden-title:-in-frontmatter": {
      "regex": "(^[tT]itle:\\s+)((.*\n))",
      "matchPosition": 1,
      "color": "#4B474A",
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true,
      "lineSpacing": 2
    },
    "formatted-title-in-frontmatter": {
      "regex": "(^[tT]itle:\\s+)((.*\n))",
      "matchPosition": 2,
      "color": "#4B474A",
      "size": 22,
      "font": "SNPro-Bold",
      "lineSpacing": 2
    },
    "hidden-obsidian-frontmatter": {
      "regex": "((?<!.)^\\s*---\\n)([\\s\\S]*?)(\\n---)",
      "matchPosition": 1,
      "isMarkdownCharacter": true,
      "isRevealOnCursorRange": true,
      "isHiddenWithoutCursor": true,
      "color": "#AA888888"
    },
    "title1": {
      "regex": "^\\h*(# )(.*)",
      "matchPosition": 2,
      "color": "#2A292E",
      "size": 24,
      "font": "SNPro-Heavy",
      "paragraphSpacing": 2
    },
    "title-mark1": {
      "regex": "^\\h*(# )(.*)",
      "matchPosition": 1,
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true,
      "color": "#A9A3A6",
      "size": 24,
      "font": "SNPro-Heavy",
      "paragraphSpacingBefore": 20,
      "paragraphSpacing": 2
    },
    "title2": {
      "regex": "^\\h*(## )(.*)",
      "matchPosition": 2,
      "color": "#2A292E",
      "size": 21,
      "font": "SNPro-Heavy"
    },
    "title2-mark": {
      "regex": "^\\h*(## )(.*)",
      "matchPosition": 1,
      "color": "#A9A3A6",
      "size": 21,
      "font": "SNPro-Heavy",
      "paragraphSpacingBefore": 10,
      "paragraphSpacing": 1
    },
    "title3": {
      "regex": "^\\h*(### )(.*)",
      "matchPosition": 2,
      "color": "#6A686F",
      "size": 18,
      "font": "SNPro-Heavy",
      "inlineBorder": true
    },
    "title3-mark": {
      "regex": "^\\h*(### )(.*)",
      "matchPosition": 1,
      "color": "#A9A3A6",
      "size": 18,
      "font": "SNPro-Heavy",
      "paragraphSpacingBefore": 10,
      "paragraphSpacing": 1
    },
    "title4": {
      "regex": "^\\h*(#### )(.*)",
      "matchPosition": 2,
      "color": "#7A7880",
      "size": 17,
      "font": "SNPro-Heavy",
      "inlineBorder": true,
    },
    "title4-mark": {
      "regex": "^\\h*(#### )(.*)",
      "matchPosition": 1,
      "color": "#A9A3A6",
      "size": 17,
      "font": "SNPro-Heavy",
      "paragraphSpacingBefore": 10,
      "paragraphSpacing": 1
    },
    "title5": {
      "regex": "^\\h*(#####+ )(.*)",
      "matchPosition": 2,
      "color": "#7A7880",
      "size": 17,
      "font": "SNPro-HeavyItalic",
      "inlineBorder": true
    },
    "title5-mark": {
      "regex": "^\\h*(#####+ )(.*)",
      "matchPosition": 1,
      "color": "#A9A3A6",
      "size": 17,
      "font": "SNPro-HeavyItalic",
      "paragraphSpacingBefore": 10,
      "paragraphSpacing": 1
    },
    "working-on": {
      "regex": "(^[\\h\\v]*[\\*|-|+] (\\[ \\] )?)(.*>>.*[\\h\\v\\n])",
      "matchPosition": 3,
      "color": "#4B474A",
      "backgroundColor": "##B4C4B5",
      "borderRadius": 6,
      "leftBorderPadding": 6,
      "rightBorderPadding": 6,
      "inlineBorder": true
    },
    "waiting-on": {
      "regex": "(^[\\h\\v]*[\\*|-|+] (\\[ \\] )?)(.*<<.*[\\h\\v\\n])",
      "matchPosition": 3,
      "color": "#4B474A",
      "backgroundColor": "#E3D6E5",
      "borderRadius": 6,
      "leftBorderPadding": 6,
      "rightBorderPadding": 6
    },
    "flagged-1": {
      "regex": "(^[\\h\\v]*[\\*|-|+] (\\[ \\] )?)(.*(?<!!)!(?!!).*[\\h\\v])",
      "matchPosition": 3,
      "backgroundColor": "#FCDEE1",
      "color": "#4B474A",
      "font": "SNPro-Medium"
    },
    "flagged-2": {
      "regex": "(^[\\h\\v]*[\\*|-|+] (\\[ \\] )?)(.*(?<!!|<<|>>)!!(?!!).*[\\h\\v])",
      "matchPosition": 3,
      "backgroundColor": "#FCD1D6",
      "color": "#4B474A",
      "font": "SNPro-Semibold"
    },
    "flagged-3": {
      "regex": "(^[\\h\\v]*[\\*|-|+] (\\[ \\] )?)(.*!{3,}.*[\\h\\v])",
      "matchPosition": 3,
      "backgroundColor": "#FCB2BB",
      "color": "#4B474A",
      "font": "SNPro-Bold"
    },
    "bold": {
      "color": "#4B474A",
      "font": "SNPro-Heavy",
      "size": 17
    },
    "bold-left-mark": {
      "color": "#A9A3A6"
    },
    "bold-right-mark": {
      "color": "#A9A3A6"
    },
    "italic": {
      "color": "#6584A2",
      "font": "SNPro-MediumItalic",
      "size": 16
    },
    "italic-left-mark": {
      "color": "#A9A3A6"
    },
    "italic-right-mark": {
      "color": "#A9A3A6"
    },
    "boldItalic": {
      "font": "SNPro-HeavyItalic",
      "size": 17
    },
    "boldItalic-left-mark": {
      "color": "#A9A3A6"
    },
    "boldItalic-right-mark": {
      "color": "#A9A3A6"
    },
    "code": {
      "font": "JetBrainsMono-Regular",
      "size": 15,
      "backgroundColor": "#E9E0DB",
      "color": "#4B474A",
      "borderRadius": 6,
      "inlineBorder": true,
      "leftBorderPadding": 1,
      "rightBorderPadding": 1
    },
    "code-fence": {
      "theme": "gruvbox-light",
      "body": {
        "font": "JetBrainsMono-Regular",
        "paragraphSpacingBefore": 0,
        "paragraphSpacing": 0,
        "size": 14
      },
      "corner-radius": 8,
      "fence-open": {
        "color": "#6584A2"
      },
      "fence-close": {
        "color": "#6584A2"
      },
      "language-specifier": {
        "font": "JetBrainsMono-Italic",
        "color": "#FCACB6",
        "size": 14,
        "paragraphSpacing": 0
      }
    },
    "code-left-backtick": {
      "color": "#6584A2"
    },
    "code-right-backtick": {
      "color": "#6584A2"
    },
    "checked": {
      "color": "#98B198",
      "headIndent": 33
    },
    "checked-canceled": {
      "strikethroughStyle": 1,
      "matchPosition": 3,
      "regex": "(^\\h*[\\+|\\*\\-]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\-\\] )(.*)",
      "color": "#928383"
    },
    "checked-canceled-marker": {
      "matchPosition": 1,
      "regex": "(^\\h*[\\+|\\*\\-]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\-\\] )(.*)",
      "color": "#928383"
    },
    "checked-scheduled": {
      "regex": "(^\\h*[\\*\\-]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\>\\] )(.*)",
      "matchPosition": 0,
      "color": "#6584A2"
    },
    "todo": {
      "font": "noteplanstate",
      "color": "#6584A2",
      "headIndent": 33,
      "size": 16
    },
    "checked-todo-characters": {
      "font": "noteplanstate",
      "headIndent": 33,
      "size": 16
    },
    "tabbed": {
      "headIndent": 43
    },
    "quote-mark": {
      "color": "#6584A2",
      "font": "noteplanstate",
      "headIndent": 33,
      "size": 16
    },
    "quote-content": {
      "color": "#6584A2",
      "type": "italic",
      "headIndent": 33
    },
    "link": {},
    "schedule-to-date-link": {},
    "done-date": {},
    "schedule-from-date-link": {},
    "note-title-link": {},
    "hashtag": {
      "backgroundColor": "#ECE7E4",
      "leftBorderPadding": 1,
      "rightBorderPadding": 2,
      "inlineBorder": true
